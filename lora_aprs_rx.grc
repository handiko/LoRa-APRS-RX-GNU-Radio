- name: lora_dec
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nLoRa PHY Decoder -- inverse of the LoRa PHY chain (same\
      \ design as\nlora_trx_sim.grc, EPB #4).\n\nInput : int16 symbol values (FFT\
      \ argmax bins) from the stock Argmax block.\n        A 'frame_start' tag (set\
      \ by the Frame Sync block, carried through the\n        stock Multiply/FFT/Mag^2/Argmax\
      \ blocks) marks the first symbol of a frame.\n\nPer symbol:   bin -> (bin -\
      \ 1) mod N -> Gray code -> (>> 2 for reduced rate)\nPer block:    de-interleave\
      \ (undo the diagonal) -> Hamming decode -> nibbles\nHeader block: 8 symbols,\
      \ SF-2 bits, CR 4/8 -> length, CR, CRC flag, checksum.\n              Result\
      \ is sent back to Frame Sync ('frame_info') so it knows how\n              many\
      \ more symbols to cut out of the stream.\nPayload:      nibbles (low first)\
      \ -> bytes -> de-whiten -> CRC-16 check.\n\nMessage out 'frame_info': {'n_sym':\
      \ n} or {'abort': True}\nMessage out 'payload'   : PDU (meta dict, u8vector)\
      \ for every decoded frame.\n\"\"\"\nimport numpy as np\nimport pmt\nfrom gnuradio\
      \ import gr\n\n\ndef lora_n_payload_symbols(sf, cr, payload_len, has_crc, ldro):\n\
      \    num = 8 * payload_len - 4 * sf + 28 + 16 * int(bool(has_crc))\n    den\
      \ = 4 * (sf - 2 * int(bool(ldro)))\n    return 8 + max(-(-num // den) * (cr\
      \ + 4), 0)\n\n\ndef hamming_enc(nib, cr_app):                       # identical\
      \ to the TX encoder\n    d = [(nib >> 3) & 1, (nib >> 2) & 1, (nib >> 1) & 1,\
      \ nib & 1]\n    if cr_app == 1:\n        p4 = d[0] ^ d[1] ^ d[2] ^ d[3]\n  \
      \      return (d[3] << 4) | (d[2] << 3) | (d[1] << 2) | (d[0] << 1) | p4\n \
      \   p0 = d[3] ^ d[2] ^ d[1]\n    p1 = d[2] ^ d[1] ^ d[0]\n    p2 = d[3] ^ d[2]\
      \ ^ d[0]\n    p3 = d[3] ^ d[1] ^ d[0]\n    cw = ((d[3] << 7) | (d[2] << 6) |\
      \ (d[1] << 5) | (d[0] << 4) |\n          (p0 << 3) | (p1 << 2) | (p2 << 1) |\
      \ p3)\n    return cw >> (4 - cr_app)\n\n\nclass blk(gr.sync_block):\n    \"\"\
      \"LoRa PHY Decoder: Gray, de-interleave, Hamming, header, de-whiten, CRC\"\"\
      \"\n\n    def __init__(self, sf=12, ldro=1, verbose=True):\n        gr.sync_block.__init__(self,\
      \ name='LoRa PHY Decoder',\n                               in_sig=[np.int16],\
      \ out_sig=None)\n        self.sf = int(sf)\n        self.N = 1 << self.sf\n\
      \        self.ldro = bool(ldro)\n        self.verbose = bool(verbose)\n    \
      \    seq, reg = [], 0xFF\n        for _ in range(255):\n            seq.append(reg)\n\
      \            fb = ((reg >> 7) ^ (reg >> 5) ^ (reg >> 4) ^ (reg >> 3)) & 1\n\
      \            reg = ((reg << 1) & 0xFF) | fb\n        self.whitening_seq = np.array(seq,\
      \ dtype=np.uint8)\n        # code books for nearest-codeword decoding\n    \
      \    self.book = {c: [hamming_enc(n, c) for n in range(16)] for c in (1, 2,\
      \ 3, 4)}\n        self.message_port_register_out(pmt.intern('frame_info'))\n\
      \        self.message_port_register_out(pmt.intern('payload'))\n        self.syms\
      \ = None\n        self.hdr = None\n        self.meta = {}\n        self.stats\
      \ = {'frames': 0, 'crc_ok': 0, 'crc_bad': 0, 'hdr_bad': 0}\n\n    # ----------------\
      \ symbol -> bits ----------------\n    def sym_to_word(self, s, reduced):\n\
      \        v = (int(s) - 1) % self.N          # undo the +1 shift\n        v ^=\
      \ v >> 1                        # Gray code (undoes TX inverse-Gray)\n     \
      \   return v >> 2 if reduced else v    # reduced rate: drop the 2 LSBs\n\n \
      \   @staticmethod\n    def deinterleave(words, sf_app, cw_len):\n        cws\
      \ = []\n        for k in range(sf_app):\n            c = 0\n            for\
      \ i in range(cw_len):\n                j = (i - k - 1) % sf_app\n          \
      \      c = (c << 1) | ((words[i] >> (sf_app - 1 - j)) & 1)\n            cws.append(c)\n\
      \        return cws\n\n    def hamming_dec(self, cw, cr_app):\n        if cr_app\
      \ >= 3:                    # 4/7, 4/8: correct 1 bit (nearest codeword)\n  \
      \          dists = [bin(cw ^ c).count('1') for c in self.book[cr_app]]\n   \
      \         return int(np.argmin(dists))\n        top = cw >> cr_app         \
      \        # 4/5, 4/6: detection only, just read data bits\n        return ((top\
      \ >> 3) & 1) | (((top >> 2) & 1) << 1) | (((top >> 1) & 1) << 2) | ((top & 1)\
      \ << 3)\n\n    def block_nibbles(self, syms, sf_app, cr_app):\n        reduced\
      \ = sf_app != self.sf\n        words = [self.sym_to_word(s, reduced) for s in\
      \ syms]\n        return [self.hamming_dec(c, cr_app)\n                for c\
      \ in self.deinterleave(words, sf_app, cr_app + 4)]\n\n    @staticmethod\n  \
      \  def crc16(data):\n        crc = 0\n        for byte in data:\n          \
      \  byte = int(byte)\n            for _ in range(8):\n                if ((crc\
      \ & 0x8000) >> 8) ^ (byte & 0x80):\n                    crc = ((crc << 1) ^\
      \ 0x1021) & 0xFFFF\n                else:\n                    crc = (crc <<\
      \ 1) & 0xFFFF\n                byte = (byte << 1) & 0xFF\n        return crc\n\
      \n    # ---------------- frame logic ----------------\n    def parse_header(self):\n\
      \        nib = self.block_nibbles(self.syms[:8], self.sf - 2, 4)\n        h0,\
      \ h1, h2, c4n, c30 = nib[:5]\n        b = lambda v, k: (v >> k) & 1\n      \
      \  c4 = b(h0, 3) ^ b(h0, 2) ^ b(h0, 1) ^ b(h0, 0)\n        c3 = b(h0, 3) ^ b(h1,\
      \ 3) ^ b(h1, 2) ^ b(h1, 1) ^ b(h2, 0)\n        c2 = b(h0, 2) ^ b(h1, 3) ^ b(h1,\
      \ 0) ^ b(h2, 3) ^ b(h2, 1)\n        c1 = b(h0, 1) ^ b(h1, 2) ^ b(h1, 0) ^ b(h2,\
      \ 2) ^ b(h2, 1) ^ b(h2, 0)\n        c0 = b(h0, 0) ^ b(h1, 1) ^ b(h2, 3) ^ b(h2,\
      \ 2) ^ b(h2, 1) ^ b(h2, 0)\n        L, cr, crc = (h0 << 4) | h1, h2 >> 1, h2\
      \ & 1\n        if (c4n & 1) != c4 or c30 != ((c3 << 3) | (c2 << 2) | (c1 <<\
      \ 1) | c0) \\\n                or L == 0 or not 1 <= cr <= 4:\n            return\
      \ None\n        return {'len': L, 'cr': cr, 'crc': crc, 'nibs': nib[5:],\n \
      \               'n_sym': lora_n_payload_symbols(self.sf, cr, L, crc, self.ldro)}\n\
      \n    def finish_frame(self):\n        h = self.hdr\n        nibs = list(h['nibs'])\n\
      \        sf_app = self.sf - 2 if self.ldro else self.sf\n        cw_len = 4\
      \ + h['cr']\n        rest = self.syms[8:h['n_sym']]\n        for i in range(0,\
      \ len(rest), cw_len):\n            nibs += self.block_nibbles(rest[i:i + cw_len],\
      \ sf_app, h['cr'])\n        L = h['len']\n        wh = np.array([nibs[2 * i]\
      \ | (nibs[2 * i + 1] << 4) for i in range(L)], dtype=np.uint8)\n        payload\
      \ = wh ^ self.whitening_seq[:L]\n        crc_ok = None\n        if h['crc']:\n\
      \            cn = nibs[2 * L:2 * L + 4]\n            rx_crc = cn[0] | (cn[1]\
      \ << 4) | (cn[2] << 8) | (cn[3] << 12)\n            calc = self.crc16(payload[:-2])\
      \ ^ int(payload[-1]) ^ (int(payload[-2]) << 8)\n            crc_ok = rx_crc\
      \ == calc\n        self.stats['frames'] += 1\n        self.stats['crc_ok' if\
      \ crc_ok in (True, None) else 'crc_bad'] += 1\n        meta = dict(self.meta)\n\
      \        meta.update({'len': L, 'cr': '4/%d' % (4 + h['cr']),\n            \
      \         'crc': {True: 'OK', False: 'FAIL', None: 'none'}[crc_ok]})\n     \
      \   self.message_port_pub(pmt.intern('payload'),\n                         \
      \     pmt.cons(pmt.to_pmt(meta), pmt.init_u8vector(L, payload.tolist())))\n\
      \        if self.verbose:\n            print('[LoRa RX] frame %d  len %d  CR\
      \ %s  CRC %s  CFO %+.0f Hz  SNR %.1f dB'\n                  % (self.stats['frames'],\
      \ L, meta['cr'], meta['crc'],\n                     meta.get('cfo_hz', 0.0),\
      \ meta.get('snr_db', 0.0)), flush=True)\n\n    def work(self, input_items, output_items):\n\
      \        inp = input_items[0]\n        base = self.nitems_read(0)\n        starts\
      \ = {t.offset - base: t for t in\n                  self.get_tags_in_window(0,\
      \ 0, len(inp), pmt.intern('frame_start'))}\n        for i in range(len(inp)):\n\
      \            if i in starts:\n                self.syms, self.hdr = [], None\n\
      \                try:\n                    self.meta = pmt.to_python(starts[i].value)\n\
      \                except Exception:\n                    self.meta = {}\n   \
      \         if self.syms is None:\n                continue\n            self.syms.append(int(inp[i]))\n\
      \            if self.hdr is None and len(self.syms) == 8:\n                self.hdr\
      \ = self.parse_header()\n                if self.hdr is None:\n            \
      \        self.stats['hdr_bad'] += 1\n                    if self.verbose:\n\
      \                        print('[LoRa RX] header checksum failed', flush=True)\n\
      \                    self.message_port_pub(pmt.intern('frame_info'),\n     \
      \                                     pmt.to_pmt({'abort': True}))\n       \
      \             self.syms = None\n                    continue\n             \
      \   self.message_port_pub(pmt.intern('frame_info'),\n                      \
      \                pmt.to_pmt({'n_sym': self.hdr['n_sym']}))\n            if self.hdr\
      \ is not None and len(self.syms) == self.hdr['n_sym']:\n                self.finish_frame()\n\
      \                self.syms, self.hdr = None, None\n        return len(inp)\n"
    affinity: ''
    alias: ''
    comment: 'EPB #2: Gray, de-interleave, Hamming, header,

      de-whiten, CRC-16 -> payload PDU'
    ldro: ldro
    maxoutbuf: '0'
    minoutbuf: '0'
    sf: sf
    verbose: 'True'
  states:
    _io_cache: '(''LoRa PHY Decoder'', ''blk'', [(''sf'', ''12''), (''ldro'', ''1''),
      (''verbose'', ''True'')], [(''0'', ''short'', 1)], [(''payload'', ''message'',
      1), (''frame_info'', ''message'', 1)], ''LoRa PHY Decoder: Gray, de-interleave,
      Hamming, header, de-whiten, CRC'', [''ldro'', ''sf'', ''verbose''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1448, 920]
    rotation: 0
    state: enabled
- name: lora_sync
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nLoRa Frame Synchroniser -- the one part of a LoRa receiver\
      \ GNU Radio has no\nstock block for: deciding WHERE each symbol starts and HOW\
      \ FAR off-tune we are.\n(Same design as lora_trx_sim.grc, EPB #3.)\n\nInput\
      \ : complex baseband at os samples per chip (samp_rate = os * bw)\nOutput: a\
      \ complex STREAM, emitted in blocks of N = 2^SF samples, ONE BLOCK PER\n   \
      \     PAYLOAD SYMBOL (a stock Stream to Vector N block downstream turns each\n\
      \        block into one vector). Each block is already\n        - aligned to\
      \ the symbol boundary (integer + fractional timing),\n        - decimated to\
      \ 1 sample per chip at the best sampling phase,\n        - frequency-corrected\
      \ (fractional + integer CFO),\n        - drift-corrected (sampling-clock offset\
      \ derived from the CFO).\n        The de-chirp, FFT and argmax that turn these\
      \ vectors into symbol\n        values are done DOWNSTREAM by stock blocks (Multiply\
      \ Const, FFT,\n        Complex to Mag^2, Argmax).\n        The first sample\
      \ of every frame carries a 'frame_start' stream tag.\n        (Why a stream\
      \ and not a vector port: GRC sizes Embedded-Python ports\n        from the constructor's\
      \ DEFAULT arguments, so a vector port would stay\n        at the default SF's\
      \ length and turn the connection red for other SFs.)\n\nMessage in 'frame_info':\
      \ the header decoder answers {'n_sym': n} (total symbols\n        incl. the\
      \ 8 header symbols) or {'abort': True} after the first 8.\n\nState machine:\n\
      \  DETECT  free-running de-chirp (window grid not aligned to anything).\n  \
      \        A preamble = several consecutive windows whose FFT peak sits in\n \
      \         the SAME bin.  That bin = timing offset + CFO (mixed together).\n\
      \  ALIGN   (instant) fractional CFO from the peak's phase rotation between\n\
      \          windows; fractional timing by trying all os sampling phases;\n  \
      \        shift the window grid by the peak bin -> up-chirps now land in bin\
      \ 0.\n  SFD     step symbol by symbol, de-chirping each window with BOTH chirp\n\
      \          directions.  Sync-word chirps show up as bins (8*hi, 8*lo).\n   \
      \       The first window where the DOWN-chirp de-chirp wins is the SFD;\n  \
      \        its bin = 2 x integer CFO  -> CFO and timing finally separated.\n \
      \ OUTPUT  emit 8 header symbols, wait for the header decoder's length,\n   \
      \       emit the rest, go back to DETECT.\n\"\"\"\nimport numpy as np\nimport\
      \ pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n    \"\"\"LoRa\
      \ Frame Sync: preamble detect, CFO/STO estimation, SFD, symbol windows\"\"\"\
      \n\n    def __init__(self, sf=12, bw=125e3, samp_rate=500e3, sync_word=0x12,\n\
      \                 preamble_len=8, center_freq=432.15e6, sro_comp=True, track=True,\n\
      \                 verbose=True):\n        self.sf = int(sf)\n        self.N\
      \ = 1 << self.sf\n        gr.basic_block.__init__(self, name='LoRa Frame Sync',\n\
      \                                in_sig=[np.complex64],\n                  \
      \              out_sig=[np.complex64])\n        self.set_output_multiple(self.N)\
      \            # always emit whole symbols\n        self.bw = float(bw)\n    \
      \    self.fs = float(samp_rate)\n        os_f = self.fs / self.bw\n        assert\
      \ abs(os_f - round(os_f)) < 1e-9 and os_f >= 1, \\\n            'samp_rate must\
      \ be an integer multiple of bw'\n        self.os = int(round(os_f))\n      \
      \  self.L = self.N * self.os                    # input samples per symbol\n\
      \        self.preamble_len = int(preamble_len)\n        sw = int(sync_word)\
      \ & 0xFF\n        self.sync_syms = ((sw >> 4) << 3, (sw & 0x0F) << 3)\n    \
      \    self.fc = float(center_freq)\n        self.sro_comp = bool(sro_comp) and\
      \ self.fc > 0\n        self.verbose = bool(verbose)\n        self.track = bool(track)\n\
      \        # Frequency tracking through the payload (2nd-order loop, units = FFT\
      \ bins).\n        # Real trackers drift tens of Hz during a 3 s SF12 frame (PA\
      \ warms the crystal);\n        # 1 bin is only 30.5 Hz at SF12/125k, so a frequency\
      \ frozen at the preamble\n        # pushes late symbols into the neighbouring\
      \ bin.\n        self.trk_g1 = 0.3                             # phase-detector\
      \ -> frequency gain\n        self.trk_g2 = 0.02                            #\
      \ -> frequency-rate gain (follows ramps)\n        self.trk_gate = 2.0 * np.log(self.N)\
      \          # only learn from clearly-decided symbols\n        self.kk = np.arange(self.N)\n\
      \n        n = np.arange(self.N)\n        self.up = np.exp(2j * np.pi * (n *\
      \ n / (2.0 * self.N) - n / 2.0))  # base up-chirp, 1 sample/chip\n        self.down\
      \ = np.conj(self.up)\n\n        self.DET = 3                               \
      \   # consecutive matching windows = preamble\n        self.thr = 1.5 * np.log(self.N)\
      \               # min peak-to-mean ratio of a window\n        # noise alone\
      \ passes thr in ~N*exp(-thr) = 1.5 % of windows (SF12); three in a\n       \
      \ # row within +-1 bin of each other: ~1e-12 per window -> no false alarms.\n\
      \n        self.buf = np.zeros(0, dtype=np.complex64)\n        self.buf_start\
      \ = 0                            # absolute index of buf[0]\n        self.pos\
      \ = 0.0                                # absolute index of next window start\n\
      \        self.reset()\n\n        self.message_port_register_in(pmt.intern('frame_info'))\n\
      \        self.set_msg_handler(pmt.intern('frame_info'), self.handle_frame_info)\n\
      \        self.set_tag_propagation_policy(gr.TPP_DONT)\n        self.frames =\
      \ 0\n\n    # ------------------------------------------------------------ helpers\n\
      \    def reset(self):\n        self.state = 'DETECT'\n        self.hist = []\
      \          # DETECT: (start, Y, k) of recent windows\n        self.cfo_norm\
      \ = 0.0     # applied CFO correction, cycles per input sample\n        self.up_bins\
      \ = []       # SFD search: bins of up-chirp windows seen\n        self.L_eff\
      \ = float(self.L)\n        self.trk_f = 0.0        # tracked extra frequency\
      \ correction [bins]\n        self.trk_r = 0.0        # tracked drift rate [bins/symbol]\n\
      \        self.trk_hist = []\n        self.n_out = 0\n        self.n_total =\
      \ None\n        self.info = {}\n\n    def handle_frame_info(self, msg):\n  \
      \      d = pmt.to_python(msg)\n        if self.state != 'OUTPUT':\n        \
      \    return\n        if d.get('abort', False):\n            if self.verbose:\n\
      \                print('[LoRa sync] header rejected -> back to DETECT', flush=True)\n\
      \            self.reset()\n        else:\n            self.n_total = int(d['n_sym'])\n\
      \n    def have(self, start, length):\n        s = int(round(start))\n      \
      \  return s >= self.buf_start and s + length <= self.buf_start + len(self.buf)\n\
      \n    def window(self, start, phase=0):\n        \"\"\"N samples, one per chip,\
      \ starting at absolute sample start+phase, CFO-corrected.\"\"\"\n        idx\
      \ = int(round(start)) + phase + np.arange(self.N) * self.os\n        x = self.buf[idx\
      \ - self.buf_start].astype(np.complex128)\n        if self.cfo_norm != 0.0:\n\
      \            x = x * np.exp(-2j * np.pi * ((self.cfo_norm * idx) % 1.0))\n \
      \       return x\n\n    def spec_up(self, x):     # de-chirp UP-chirps (multiply\
      \ by down-chirp), FFT\n        return np.fft.fft(x * self.down)\n\n    def spec_down(self,\
      \ x):   # de-chirp DOWN-chirps (multiply by up-chirp), FFT\n        return np.fft.fft(x\
      \ * self.up)\n\n    def signed(self, k):\n        return k - self.N if k >=\
      \ self.N // 2 else k\n\n    # ------------------------------------------------------------\
      \ states\n    def step_detect(self):\n        if not self.have(self.pos, self.L\
      \ + self.os):\n            return False\n        Y = self.spec_up(self.window(self.pos))\n\
      \        P = np.abs(Y) ** 2\n        k = int(np.argmax(P))\n        ratio =\
      \ P[k] / (np.mean(P) + 1e-30)\n        if ratio > self.thr:\n            self.hist.append((self.pos,\
      \ Y, k))\n            self.hist = self.hist[-self.DET:]\n        else:\n   \
      \         self.hist = []\n        if len(self.hist) == self.DET:\n         \
      \   ks = [h[2] for h in self.hist]\n            ok = all(abs(self.signed((ks[i\
      \ + 1] - ks[i]) % self.N)) <= 1\n                     for i in range(self.DET\
      \ - 1))\n            if ok:\n                self.align()\n                return\
      \ True\n            self.hist = self.hist[1:]\n        self.pos += self.L\n\
      \        return True\n\n    def align(self):\n        # (1) fractional CFO:\
      \ the preamble is periodic, so window i+1 is window i\n        #     rotated\
      \ by 2*pi*CFO[bins].  Only the fraction of a bin is visible.\n        k0 = self.hist[-1][2]\n\
      \        z = sum(self.hist[i + 1][1][k0] * np.conj(self.hist[i][1][k0])\n  \
      \              for i in range(self.DET - 1))\n        cfo_frac = np.angle(z)\
      \ / (2 * np.pi)                     # bins, (-0.5, 0.5]\n        self.cfo_norm\
      \ = cfo_frac / self.L                         # cycles / input sample\n\n  \
      \      # (2) fractional timing: try every sampling phase, keep the sharpest\
      \ peak\n        w = self.hist[-1][0]\n        best = (-1.0, 0, 0)\n        for\
      \ d in range(self.os):\n            P = np.abs(self.spec_up(self.window(w, d)))\
      \ ** 2 + \\\n                np.abs(self.spec_up(self.window(w - self.L, d)))\
      \ ** 2\n            k = int(np.argmax(P))\n            if P[k] > best[0]:\n\
      \                best = (P[k], d, k)\n        Pk, d, k = best\n        P = np.abs(self.spec_up(self.window(w,\
      \ d))) ** 2\n        noise = (np.sum(P) - P[k]) / (self.N - 1)\n        snr\
      \ = 10 * np.log10(max(P[k] - noise, 1e-12) / (self.N * noise + 1e-30))\n\n \
      \       # (3) integer alignment: peak bin k = timing offset + integer CFO (chips).\n\
      \        #     Shift the grid by k chips so preamble up-chirps de-chirp to bin\
      \ 0.\n        self.pos = w + d - self.signed(k) * self.os\n        self.info\
      \ = {'cfo_frac_bins': float(cfo_frac), 'preamble_bin': int(k),\n           \
      \          'phase': int(d), 'snr_db': float(snr)}\n        self.state = 'SFD'\n\
      \        self.up_bins = []\n        self.align_pos = self.pos              \
      \   # reference instant for drift correction\n\n    def step_sfd(self):\n  \
      \      if not self.have(self.pos, self.L + self.os):\n            return False\n\
      \        x = self.window(self.pos)\n        Pu = np.abs(self.spec_up(x)) **\
      \ 2\n        Pd = np.abs(self.spec_down(x)) ** 2\n        ku, kd = int(np.argmax(Pu)),\
      \ int(np.argmax(Pd))\n        if Pd[kd] <= Pu[ku]:                       # still\
      \ an up-chirp (preamble / sync)\n            self.up_bins.append(ku)\n     \
      \       if len(self.up_bins) > self.preamble_len + 4:\n                self.reset()\
      \                       # never found an SFD: false alarm\n            self.pos\
      \ += self.L\n            return True\n\n        # ---- SFD found.\n        #\
      \ Since ALIGN the grid has stepped by the nominal L, so clock drift has moved\n\
      \        # it by d chips (0.25 chip/symbol at SF12 per 60 ppm).  Up-chirps read\
      \ s + d,\n        # the SFD down-chirp reads 2*CFO - d.  d is measured from\
      \ the sync word.\n        sync = tuple(self.up_bins[-2:])\n        err = [self.signed((sync[i]\
      \ - self.sync_syms[i]) % self.N) for i in range(len(sync))]\n        d = float(np.mean(err))\
      \ if len(err) == 2 else 0.0\n        sw_ok = len(sync) == 2 and abs(d) <= 3.5\
      \ and all(abs(e - d) <= 1 for e in err)\n        f_int = int(np.round((self.signed(kd)\
      \ + d) / 2.0))\n        if not sw_ok:\n            if self.verbose:\n      \
      \          print('[LoRa sync] SFD found but sync word bins %s != %s -> ignored'\n\
      \                      % (sync, self.sync_syms), flush=True)\n            self.pos\
      \ += self.L\n            self.reset()\n            return True\n\n        self.cfo_norm\
      \ += f_int / float(self.L)\n        cfo_hz = self.cfo_norm * self.fs\n     \
      \   # The grid we aligned on was early by f_int chips (CFO masqueraded as timing).\n\
      \        # While searching for the SFD we stepped by the nominal L; the real\
      \ symbol\n        # length is L_eff (TX and RX each derive carrier AND chip\
      \ clock from one\n        # crystal -> relative clock error = -CFO/fc), so the\
      \ payload start is\n        # recomputed from the alignment instant with L_eff.\n\
      \        if self.sro_comp:\n            self.L_eff = self.L * (1.0 - cfo_hz\
      \ / self.fc)\n        n_steps = int(round((self.pos - self.align_pos) / self.L))\n\
      \        self.pos = self.align_pos + f_int * self.os + (n_steps + 2.25) * self.L_eff\n\
      \        self.info.update({'cfo_int_bins': f_int, 'cfo_hz': float(cfo_hz),\n\
      \                          'sync_bins': [int(b) for b in sync], 'drift_chips':\
      \ d})\n        self.state = 'OUTPUT'\n        self.n_out, self.n_total = 0,\
      \ None\n        self.frames += 1\n        if self.verbose:\n            print('[LoRa\
      \ sync] frame %d: SNR %.1f dB, CFO %+.0f Hz (%d + %.2f bins), '\n          \
      \        'sync word bins %s (drift %+.1f chips), sampling phase %d/%d'\n   \
      \               % (self.frames, self.info['snr_db'], cfo_hz, f_int,\n      \
      \               self.info['cfo_frac_bins'], list(sync), d, self.info['phase'],\
      \ self.os),\n                  flush=True)\n        return True\n\n    def step_output(self,\
      \ out, nout):\n        limit = 8 if self.n_total is None else self.n_total\n\
      \        if self.n_out >= limit:\n            if self.n_total is not None: \
      \           # frame complete\n                if self.verbose and self.track\
      \ and self.trk_hist:\n                    print('[LoRa sync] frame %d: frequency\
      \ tracked %+.0f Hz over the payload'\n                          % (self.frames,\
      \ (self.trk_hist[-1] - self.trk_hist[0]) * self.bw / self.N),\n            \
      \              flush=True)\n                self.reset()\n                return\
      \ nout, True\n            # waiting for the header decoder; give up after ~64\
      \ symbols of input\n            if self.buf_start + len(self.buf) - self.pos\
      \ > 64 * self.L:\n                self.reset()\n                return nout,\
      \ True\n            return nout, False\n        if nout + self.N > len(out)\
      \ or not self.have(self.pos, self.L + self.os):\n            return nout, False\n\
      \        x = self.window(self.pos)\n        if self.track:\n            # predict:\
      \ apply the frequency expected for this symbol, then measure how far\n     \
      \       # its de-chirped peak still sits from the bin centre and update the\
      \ loop\n            x = x * np.exp(-2j * np.pi * self.trk_f * self.kk / self.N)\n\
      \            Y = np.fft.fft(x * self.down)\n            P = Y.real ** 2 + Y.imag\
      \ ** 2\n            m = int(np.argmax(P))\n            if P[m] > self.trk_gate\
      \ * np.mean(P):\n                a, b, c = Y[(m - 1) % self.N], Y[m], Y[(m +\
      \ 1) % self.N]\n                den = 2 * b - a - c\n                delta =\
      \ float(np.real((a - c) / den)) if abs(den) > 0 else 0.0\n                delta\
      \ = float(np.clip(delta, -0.5, 0.5))   # residual offset [bins]\n          \
      \      self.trk_r += self.trk_g2 * delta\n                self.trk_f += self.trk_g1\
      \ * delta\n            self.trk_hist.append(self.trk_f)\n            self.trk_f\
      \ += self.trk_r\n        out[nout:nout + self.N] = x.astype(np.complex64)\n\
      \        if self.n_out == 0:\n            meta = pmt.make_dict()\n         \
      \   for k, v in self.info.items():\n                meta = pmt.dict_add(meta,\
      \ pmt.intern(k), pmt.to_pmt(v))\n            self.add_item_tag(0, self.nitems_written(0)\
      \ + nout,\n                              pmt.intern('frame_start'), meta)\n\
      \        self.n_out += 1\n        self.pos += self.L_eff\n        return nout\
      \ + self.N, True\n\n    # ------------------------------------------------------------\
      \ scheduler\n    def forecast(self, noutput_items, ninputs):\n        return\
      \ [1] * ninputs\n\n    def general_work(self, input_items, output_items):\n\
      \        inp = input_items[0]\n        n_in = len(inp)\n        if n_in:\n \
      \           self.buf = np.concatenate((self.buf, inp))\n            self.consume(0,\
      \ n_in)\n        out = output_items[0]\n        nout = 0\n        while True:\n\
      \            if self.state == 'DETECT':\n                prog = self.step_detect()\n\
      \            elif self.state == 'SFD':\n                prog = self.step_sfd()\n\
      \            else:\n                nout, prog = self.step_output(out, nout)\n\
      \            if not prog:\n                break\n        # keep 2 symbols of\
      \ history behind the read pointer (alignment looks back)\n        keep_from\
      \ = int(self.pos) - 2 * self.L - self.os\n        if keep_from > self.buf_start:\n\
      \            cut = keep_from - self.buf_start\n            self.buf = self.buf[cut:]\n\
      \            self.buf_start = keep_from\n        return nout\n"
    affinity: ''
    alias: ''
    bw: bw
    center_freq: center_freq
    comment: 'EPB #1: preamble detect, CFO + timing, SFD, clock drift,

      cuts out aligned 1-sample/chip symbol windows'
    maxoutbuf: '0'
    minoutbuf: '0'
    preamble_len: preamble_len
    samp_rate: rx_rate
    sf: sf
    sro_comp: 'True'
    sync_word: sync_word
    track: 'True'
    verbose: 'True'
  states:
    _io_cache: '(''LoRa Frame Sync'', ''blk'', [(''sf'', ''12''), (''bw'', ''125000.0''),
      (''samp_rate'', ''500000.0''), (''sync_word'', ''18''), (''preamble_len'', ''8''),
      (''center_freq'', ''432150000.0''), (''sro_comp'', ''True''), (''track'', ''True''),
      (''verbose'', ''True'')], [(''0'', ''complex'', 1), (''frame_info'', ''message'',
      1)], [(''0'', ''complex'', 1)], ''LoRa Frame Sync: preamble detect, CFO/STO
      estimation, SFD, symbol windows'', [''bw'', ''preamble_len'', ''sf'', ''sro_comp'',
      ''track'', ''verbose''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 940]
    rotation: 0
