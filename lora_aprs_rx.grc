options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'LoRa APRS receiver 432.150 MHz SF12/BW125/CR4-5: RTL-SDR -> own
      LoRa PHY (stock de-chirp/FFT + 3 EPBs) -> APRS decode'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: lora_aprs_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: LoRa APRS RX 432.150 MHz (SF12 / 125 kHz / CR 4/5)
    window_size: (1400,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: N
  id: variable
  parameters:
    comment: Chips per symbol = FFT size (4096 at SF12)
    value: 2**sf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 92]
    rotation: 0
    state: enabled
- name: bw
  id: variable
  parameters:
    comment: LoRa bandwidth = chip rate [Hz]
    value: 125e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [416, 12]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: 'LoRa APRS channel centre [Hz] (your network: 432.150 MHz).

      Also used by Frame Sync to turn the measured CFO into a clock-drift correction.'
    value: 432.150e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: cr
  id: variable
  parameters:
    comment: 'Coding rate index 1 = 4/5 ("CR5").

      INFORMATION ONLY: the decoder reads the real CR from each frame header.'
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [504, 12]
    rotation: 0
    state: enabled
- name: downchirp
  id: variable
  parameters:
    comment: 'Conjugate of the base up-chirp at 1 sample/chip: the de-chirping reference'
    value: list(np.exp(-2j*np.pi*(np.arange(N)**2/(2.0*N) - np.arange(N)/2.0)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 172]
    rotation: 0
    state: enabled
- name: if_offset
  id: variable
  parameters:
    comment: 'RTL-SDR is tuned this far BELOW the channel so LoRa sits away from the
      DC spike / IQ image;

      the Xlating filter brings it back to 0 Hz.'
    value: 200e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 92]
    rotation: 0
    state: enabled
- name: ldro
  id: variable
  parameters:
    comment: 'Low Data Rate Optimisation: ON for SF12/125k (32.8 ms symbols). SX127x/SX126x
      firmware sets it automatically.'
    value: 1 if (2**sf)/bw > 16e-3 else 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 12]
    rotation: 0
    state: enabled
- name: os_factor
  id: variable
  parameters:
    comment: RTL-SDR samples per chip
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [368, 92]
    rotation: 0
    state: enabled
- name: preamble_len
  id: variable
  parameters:
    comment: Programmed preamble length of the trackers (8 is the LoRa APRS default)
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 12]
    rotation: 0
    state: enabled
- name: rec_file
  id: variable
  parameters:
    comment: 'PLAYBACK ONLY: complex64 IQ recorded at samp_rate, tuned to center_freq
      - if_offset'
    value: '"lora_aprs_432150_1Msps.cf32"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 172]
    rotation: 0
    state: enabled
- name: rtl_gain
  id: variable_qtgui_range
  parameters:
    comment: RF gain. Start ~30 dB; back off if a nearby tracker overloads the dongle.
    gui_hint: 0,0,1,2
    label: '"RTL-SDR gain [dB]"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.1'
    stop: '49.6'
    value: '35'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 12]
    rotation: 0
    state: enabled
- name: rtl_ppm
  id: variable
  parameters:
    comment: 'RTL-SDR crystal correction [ppm]. v3/v4 (TCXO): 0..1. Old dongles: measure
      it.'
    value: '35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [896, 92]
    rotation: 0
    state: enabled
- name: rx_os
  id: variable
  parameters:
    comment: 'Samples per chip into Frame Sync (500 kS/s): 4 sampling phases for fractional
      timing'
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 92]
    rotation: 0
    state: enabled
- name: rx_rate
  id: variable
  parameters:
    comment: Sample rate into Frame Sync
    value: bw*rx_os
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 92]
    rotation: 0
    state: enabled
- name: rx_taps
  id: variable
  parameters:
    comment: 'Channel filter: pass the +-62.5 kHz LoRa channel, stop beyond 90 kHz'
    value: firdes.low_pass(1.0, samp_rate, 80e3, 20e3)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [528, 172]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'RTL-SDR sample rate: 1.000 MS/s (must be an integer multiple of bw)'
    value: bw*os_factor
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [464, 92]
    rotation: 0
    state: enabled
- name: sf
  id: variable
  parameters:
    comment: 'Spreading factor (LoRa APRS standard: SF12)'
    value: '12'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [344, 12]
    rotation: 0
    state: enabled
- name: sync_word
  id: variable
  parameters:
    comment: 'LoRa APRS uses the SX127x private sync word 0x12 (on air: bins 8 and
      16)'
    value: '0x12'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 12]
    rotation: 0
    state: enabled
- name: t_sym
  id: variable
  parameters:
    comment: 'Symbol time [s]: 32.77 ms at SF12/125k'
    value: (2**sf)/bw
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [272, 92]
    rotation: 0
    state: enabled
- name: aprs
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nLoRa APRS Parser -- message-only Embedded Python Block\
      \ (EPB #5).\n\nInput  'pdu' : PDU (meta, u8vector) from the LoRa PHY Decoder's\
      \ 'payload' port.\nOutput 'aprs': PDU (meta, u8vector) holding just the TNC2\
      \ text line\n               (\"SRC>DST,PATH:info\") of every good packet, ready\
      \ for a stock\n               Socket PDU / Message Debug / File-logging chain.\n\
      \nLoRa APRS framing (lora-aprs / CA2RXU / OE5BPA firmware family):\n    3 header\
      \ bytes  '<' 0xFF 0x01   then plain TNC2 text, no AX.25, no FCS.\n    (The LoRa\
      \ CRC-16 is the only integrity check.)\n\nDecodes the APRS formats LoRa trackers\
      \ and iGates actually send:\n    ! = / @      position, uncompressed or base-91\
      \ compressed (+course/speed/alt)\n    ` '          Mic-E (lat/lon from the destination\
      \ field, speed/course, alt)\n    ;  )         objects and items\n    :     \
      \       messages (incl. ack/rej, message number)\n    >            status\n\
      \    T#           telemetry (printed raw)\n    }            third-party (inner\
      \ packet parsed recursively)\nAnything else is printed as raw info text.\n\"\
      \"\"\nimport time\nimport urllib.parse\nimport pmt\nfrom gnuradio import gr\n\
      \nSYMBOLS = {\n    '/>': 'car', '/<': 'motorcycle', '/[': 'jogger', '/b': 'bicycle',\
      \ '/k': 'truck',\n    '/v': 'van', '/u': 'truck (18-wheeler)', '/j': 'jeep',\
      \ '/R': 'RV', '/Y': 'yacht',\n    '/s': 'ship', '/f': 'fire truck', '/a': 'ambulance',\
      \ '/O': 'balloon', '/^': 'aircraft',\n    '/X': 'helicopter', '/-': 'house',\
      \ '/#': 'digipeater', '/&': 'gateway', '/_': 'weather station',\n    '/r': 'repeater',\
      \ '/y': 'house + yagi', '/`': 'dish antenna', '/n': 'node',\n    '\\\\&': 'gateway\
      \ (overlay)', 'L&': 'LoRa iGate', 'L#': 'LoRa digipeater',\n    'I&': 'iGate',\
      \ '\\\\#': 'digipeater (overlay)', '/l': 'laptop', '/$': 'phone',\n}\n\nMICE_MSG\
      \ = {7: 'Off Duty', 6: 'En Route', 5: 'In Service', 4: 'Returning',\n      \
      \      3: 'Committed', 2: 'Special', 1: 'Priority', 0: 'EMERGENCY'}\n\n\ndef\
      \ b91(s):\n    v = 0\n    for c in s:\n        v = v * 91 + (ord(c) - 33)\n\
      \    return v\n\n\nclass blk(gr.basic_block):\n    \"\"\"LoRa APRS Parser: strips\
      \ the '<\\\\xff\\\\x01' header and decodes TNC2 APRS\"\"\"\n\n    def __init__(self,\
      \ show_bad_crc=False, log_path=''):\n        gr.basic_block.__init__(self, name='LoRa\
      \ APRS Parser', in_sig=None, out_sig=None)\n        self.show_bad_crc = bool(show_bad_crc)\n\
      \        self.log_path = str(log_path)\n        self.message_port_register_in(pmt.intern('pdu'))\n\
      \        self.set_msg_handler(pmt.intern('pdu'), self.handle)\n        self.message_port_register_out(pmt.intern('aprs'))\n\
      \        self.count = 0\n\n    # ================================================================\
      \ entry\n    def handle(self, msg):\n        try:\n            meta = pmt.to_python(pmt.car(msg))\
      \ or {}\n            data = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n   \
      \     except Exception as e:                      # not a PDU\n            print('[APRS]\
      \ bad PDU: %s' % e, flush=True)\n            return\n        crc = meta.get('crc',\
      \ 'none')\n        if crc == 'FAIL' and not self.show_bad_crc:\n           \
      \ print('[APRS] frame dropped: LoRa CRC failed (%d bytes)' % len(data), flush=True)\n\
      \            return\n\n        if data[:3] == b'<\\xff\\x01':\n            text,\
      \ framing = data[3:], 'LoRa-APRS'\n        else:\n            text, framing\
      \ = data, 'no <FF01 header'\n        line = text.decode('utf-8', errors='replace').rstrip('\\\
      r\\n\\x00')\n\n        self.count += 1\n        stamp = time.strftime('%H:%M:%S')\n\
      \        print('\\n' + '=' * 72, flush=True)\n        print('[APRS #%d %s] %s\
      \   (LoRa CRC %s, SNR %.1f dB, CFO %+.0f Hz, %s)'\n              % (self.count,\
      \ stamp, line, crc, meta.get('snr_db', 0.0),\n                 meta.get('cfo_hz',\
      \ 0.0), framing), flush=True)\n        for row in self.decode_tnc2(line):\n\
      \            print('    ' + row, flush=True)\n        print('=' * 72, flush=True)\n\
      \n        raw = line.encode('utf-8', errors='replace')\n        self.message_port_pub(pmt.intern('aprs'),\n\
      \                              pmt.cons(pmt.car(msg), pmt.init_u8vector(len(raw),\
      \ list(raw))))\n        if self.log_path:\n            try:\n              \
      \  with open(self.log_path, 'a', encoding='utf-8') as f:\n                 \
      \   f.write('%s\\t%s\\t%s\\n' % (time.strftime('%Y-%m-%d %H:%M:%S'), crc, line))\n\
      \            except OSError as e:\n                print('[APRS] log write failed:\
      \ %s' % e, flush=True)\n\n    # ================================================================\
      \ TNC2\n    def decode_tnc2(self, line, depth=0):\n        rows = []\n     \
      \   if '>' not in line or ':' not in line:\n            return ['(not a TNC2\
      \ APRS line)']\n        head, info = line.split(':', 1)\n        src, rest =\
      \ head.split('>', 1)\n        parts = rest.split(',')\n        dst, path = parts[0],\
      \ parts[1:]\n        rows.append('From %s  to %s%s' % (src, dst, ('  via ' +\
      \ ','.join(path)) if path else ''))\n        if not info:\n            return\
      \ rows + ['(empty info field)']\n        try:\n            rows += self.decode_info(info,\
      \ dst, depth)\n        except Exception as e:                       # malformed\
      \ packet: show what we can\n            rows.append('Info (unparsed, %s): %s'\
      \ % (e.__class__.__name__, info))\n        if depth == 0:\n            call\
      \ = urllib.parse.quote('a/' + src, safe='')\n            rows.append('Map: \
      \ https://aprs.fi/#!call=%s' % call)\n        return rows\n\n    def decode_info(self,\
      \ info, dst, depth):\n        t = info[0]\n        if t in '!=':\n         \
      \   return self.position(info[1:], 'Position%s' % (' (messaging)' if t == '='\
      \ else ''))\n        if t in '/@':\n            return ['Time %s' % self.timestamp(info[1:8])]\
      \ + \\\n                self.position(info[8:], 'Position%s' % (' (messaging)'\
      \ if t == '@' else ''))\n        if t in '`\\'\\x1c\\x1d':\n            return\
      \ self.mic_e(info, dst)\n        if t == ';':\n            name, live = info[1:10].rstrip(),\
      \ info[10]\n            rows = ['Object \"%s\" (%s)  time %s' % (name, 'live'\
      \ if live == '*' else 'killed',\n                                          \
      \        self.timestamp(info[11:18]))]\n            return rows + self.position(info[18:],\
      \ 'Object position')\n        if t == ')':\n            k = min([i for i in\
      \ (info.find('!', 1), info.find('_', 1)) if i > 0] or [len(info)])\n       \
      \     return ['Item \"%s\"' % info[1:k]] + self.position(info[k + 1:], 'Item\
      \ position')\n        if t == ':':\n            to, body = info[1:10].strip(),\
      \ info[11:]\n            num = ''\n            if '{' in body:\n           \
      \     body, num = body.rsplit('{', 1)\n            if body.startswith('ack')\
      \ or body.startswith('rej'):\n                return ['%s for message %s to\
      \ %s' % (body[:3].upper(), body[3:], to)]\n            return ['Message to %s:\
      \ \"%s\"%s' % (to, body, ('  [msg no %s]' % num) if num else '')]\n        if\
      \ t == '>':\n            return ['Status: %s' % info[1:]]\n        if t == 'T':\n\
      \            return ['Telemetry: %s' % info[1:]]\n        if t == '}' and depth\
      \ < 3:\n            return ['Third-party packet:'] + ['  ' + r for r in self.decode_tnc2(info[1:],\
      \ depth + 1)]\n        return ['Info: %s' % info]\n\n    # ================================================================\
      \ helpers\n    @staticmethod\n    def timestamp(s):\n        if len(s) < 7:\n\
      \            return s\n        if s[6] in 'z/':\n            return 'day %s\
      \ %s:%s %s' % (s[0:2], s[2:4], s[4:6], 'UTC' if s[6] == 'z' else 'local')\n\
      \        if s[6] == 'h':\n            return '%s:%s:%s UTC' % (s[0:2], s[2:4],\
      \ s[4:6])\n        return s\n\n    @staticmethod\n    def sym(table, code):\n\
      \        key = table + code\n        name = SYMBOLS.get(key) or SYMBOLS.get('\\\
      \\' + code if table not in '/\\\\' else key, '')\n        return 'symbol %s%s%s'\
      \ % (table, code, ('  (%s)' % name) if name else '')\n\n    @staticmethod\n\
      \    def latlon_str(lat, lon):\n        return '%+.5f, %+.5f   (%s %s)' % (\n\
      \            lat, lon,\n            \"%d\xB0%06.3f'%s\" % (int(abs(lat)), (abs(lat)\
      \ % 1) * 60, 'N' if lat >= 0 else 'S'),\n            \"%d\xB0%06.3f'%s\" % (int(abs(lon)),\
      \ (abs(lon) % 1) * 60, 'E' if lon >= 0 else 'W'))\n\n    def position(self,\
      \ s, label):\n        if not s:\n            return ['%s: (missing)' % label]\n\
      \        if s[0].isdigit() or s[0] == ' ':\n            return self.pos_uncompressed(s,\
      \ label)\n        return self.pos_compressed(s, label)\n\n    def pos_uncompressed(self,\
      \ s, label):\n        lat_s, table, lon_s, code, comment = s[0:8], s[8], s[9:18],\
      \ s[18], s[19:]\n        lat = (int(lat_s[0:2]) + float(lat_s[2:7].replace('\
      \ ', '0')) / 60.0) * \\\n            (1 if lat_s[7] in 'Nn' else -1)\n     \
      \   lon = (int(lon_s[0:3]) + float(lon_s[3:8].replace(' ', '0')) / 60.0) * \\\
      \n            (1 if lon_s[8] in 'Ee' else -1)\n        rows = ['%s: %s' % (label,\
      \ self.latlon_str(lat, lon)),\n                '%s  (uncompressed)' % self.sym(table,\
      \ code)]\n        motion = []\n        if len(comment) >= 7 and comment[3] ==\
      \ '/' and comment[:3].isdigit() and comment[4:7].isdigit():\n            motion.append('course\
      \ %d\xB0  speed %d km/h' % (int(comment[:3]),\n                            \
      \                            round(int(comment[4:7]) * 1.852)))\n          \
      \  comment = comment[7:]\n        i = comment.find('/A=')\n        if i >= 0\
      \ and comment[i + 3:i + 9].lstrip('-').isdigit():\n            motion.append('alt\
      \ %d m' % round(int(comment[i + 3:i + 9]) * 0.3048))\n            comment =\
      \ comment[:i] + comment[i + 9:]\n        if motion:\n            rows.append('\
      \  '.join(motion))\n        if comment.strip():\n            rows.append('Comment:\
      \ %s' % comment.strip())\n        return rows\n\n    def pos_compressed(self,\
      \ s, label):\n        table, lat4, lon4, code, cs, ctype, comment = s[0], s[1:5],\
      \ s[5:9], s[9], s[10:12], s[12], s[13:]\n        lat = 90.0 - b91(lat4) / 380926.0\n\
      \        lon = -180.0 + b91(lon4) / 190463.0\n        rows = ['%s: %s' % (label,\
      \ self.latlon_str(lat, lon)),\n                '%s  (compressed)' % self.sym(table,\
      \ code)]\n        motion = []\n        if cs[0] != ' ':\n            c, sp =\
      \ ord(cs[0]) - 33, ord(cs[1]) - 33\n            T = ord(ctype) - 33\n      \
      \      if (T & 0x18) == 0x10:                                  # GGA source\
      \ -> altitude\n                motion.append('alt %d m' % round((1.002 ** (c\
      \ * 91 + sp)) * 0.3048))\n            elif 0 <= c <= 89:\n                motion.append('course\
      \ %d\xB0  speed %d km/h'\n                              % (c * 4, round((1.08\
      \ ** sp - 1) * 1.852)))\n            elif c == 90:\n                motion.append('radio\
      \ range %.0f km' % (2 * 1.08 ** sp * 1.609))\n        i = comment.find('/A=')\n\
      \        if i >= 0 and comment[i + 3:i + 9].lstrip('-').isdigit():\n       \
      \     motion.append('alt %d m' % round(int(comment[i + 3:i + 9]) * 0.3048))\n\
      \            comment = comment[:i] + comment[i + 9:]\n        if motion:\n \
      \           rows.append('  '.join(motion))\n        if comment.strip():\n  \
      \          rows.append('Comment: %s' % comment.strip())\n        return rows\n\
      \n    def mic_e(self, info, dst):\n        d = dst.split('-')[0]\n        if\
      \ len(d) < 6 or len(info) < 9:\n            return ['Mic-E (truncated): %s'\
      \ % info]\n        digits, bits, custom = [], [], False\n        for ch in d[:6]:\n\
      \            if ch.isdigit():\n                digits.append(int(ch)); bits.append(0)\n\
      \            elif 'A' <= ch <= 'J':\n                digits.append(ord(ch) -\
      \ 65); bits.append(1); custom = True\n            elif 'P' <= ch <= 'Y':\n \
      \               digits.append(ord(ch) - 80); bits.append(1)\n            elif\
      \ ch in 'KLZ':\n                digits.append(0); bits.append(0 if ch == 'L'\
      \ else 1); custom |= ch == 'K'\n            else:\n                return ['Mic-E\
      \ (bad destination %s): %s' % (dst, info)]\n        lat = digits[0] * 10 + digits[1]\
      \ + (digits[2] * 10 + digits[3] + (digits[4] * 10 + digits[5]) / 100.0) / 60.0\n\
      \        north = d[3] >= 'P'\n        lon_off = 100 if d[4] >= 'P' else 0\n\
      \        west = d[5] >= 'P'\n        lat = lat if north else -lat\n\n      \
      \  deg = ord(info[1]) - 28 + lon_off\n        if 180 <= deg <= 189:\n      \
      \      deg -= 80\n        elif 190 <= deg <= 199:\n            deg -= 190\n\
      \        mins = ord(info[2]) - 28\n        if mins >= 60:\n            mins\
      \ -= 60\n        hund = ord(info[3]) - 28\n        lon = deg + (mins + hund\
      \ / 100.0) / 60.0\n        lon = -lon if west else lon\n\n        sp, dc, se\
      \ = ord(info[4]) - 28, ord(info[5]) - 28, ord(info[6]) - 28\n        speed =\
      \ sp * 10 + dc // 10\n        if speed >= 800:\n            speed -= 800\n \
      \       course = (dc % 10) * 100 + se\n        if course >= 400:\n         \
      \   course -= 400\n        code, table, comment = info[7], info[8], info[9:]\n\
      \n        msg_id = bits[0] * 4 + bits[1] * 2 + bits[2]\n        status = ('Custom-%d'\
      \ % msg_id) if custom else MICE_MSG.get(msg_id, '?')\n        rows = ['Mic-E\
      \ position: %s' % self.latlon_str(lat, lon),\n                '%s   status:\
      \ %s' % (self.sym(table, code), status)]\n        motion = ['course %d\xB0 \
      \ speed %d km/h' % (course, round(speed * 1.852))]\n        # optional altitude:\
      \ 3 base-91 chars followed by '}' (metres + 10000)\n        for k in (0, 1):\n\
      \            if len(comment) >= k + 4 and comment[k + 3] == '}':\n         \
      \       motion.append('alt %d m' % (b91(comment[k:k + 3]) - 10000))\n      \
      \          comment = comment[:k] + comment[k + 4:]\n                break\n\
      \        rows.append('  '.join(motion))\n        comment = comment.lstrip('>]`\\\
      '').rstrip()\n        if comment:\n            rows.append('Comment: %s' % comment)\n\
      \        return rows\n"
    affinity: ''
    alias: ''
    comment: 'EPB #3: strip "<\xff\x01", parse TNC2 APRS,

      print position / Mic-E / message / status.

      log_path="lora_aprs.log" to keep a log.'
    log_path: '""'
    maxoutbuf: '0'
